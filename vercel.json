{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate, max-age=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/health", "destination": "/api/cron-step" },
    { "source": "/api/binance/vault-transfer", "destination": "/api/binance-vault" },
    { "source": "/api/alpaca/order", "destination": "/api/alpaca-order" }
  ]
}
